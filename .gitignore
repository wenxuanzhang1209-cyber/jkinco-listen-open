# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
.venv/
.venv-test/
# 任何命名的虚拟环境。只列 .venv/ 的话，别人用 .venv3 / env / .vc 之类的名字
# 就挡不住，而 774MB 的 site-packages 一旦提交上去就很难从历史里拿干净。
# Any virtualenv, whatever it is named. Listing only .venv/ leaves .venv3, env, and
# friends unguarded — and a committed 774 MB site-packages is painful to remove from history.
.venv*/
venv/
env/
ENV/

# Node / frontend build
node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo
frontend/.npm-cache/

# Secrets & local config —— 任何 API Key / 密钥都严禁提交
.env
*.pem
*.key
*.p12
*.pfx

# macOS
.DS_Store

# Runtime artifacts & data
artifacts/
exports/
history/
models/
*.log
.active-main-port

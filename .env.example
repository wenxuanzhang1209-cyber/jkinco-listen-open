# =========================================================
#  JKinco Listen · Open Edition / 筑听 · 开源本地版
#  Runs 100% locally. No cloud API key required.
#  100% 本地运行，无需任何云端 API Key
#  Copy to .env and adjust. / 复制为 .env 后按需修改
# =========================================================

# ---- Local accounts / 本地账号 ----
# Format: username:password, comma-separated for several accounts.
# 格式：username:password，多个用逗号分隔
#
# ⚠️  CHANGE THIS BEFORE EXPOSING THE SERVICE TO A NETWORK.
#     The server listens on 0.0.0.0, so anyone who can reach the port can sign in
#     with the default below. It exists only so a local trial works immediately.
# ⚠️  接到网络上之前务必修改。服务监听 0.0.0.0，只要能访问到端口的人都能用下面这组
#     默认口令登录。它的存在只是为了让本地试用能立刻跑起来。
JKINCO_AUTH=admin:123456

# Session signing key. Generate once and keep it: changing it logs everyone out.
# 会话签名密钥：生成一次并固定，重启后登录态不失效
# openssl rand -base64 48
JKINCO_SESSION_SECRET=

# ---- Local LLM (OpenAI-compatible endpoint; Ollama by default) ----
# ---- 本地大模型（OpenAI 兼容接口，默认 Ollama）----
LLM_BASE_URL=http://127.0.0.1:11434/v1/chat/completions
LLM_MODEL_NAME=qwen2.5:7b-instruct
JKINCO_LLM_FALLBACK_MODEL=
JKINCO_LLM_ATTEMPT_TIMEOUT=120
JKINCO_LLM_THINKING=1
JKINCO_QUALITY_REVIEW=1

# ---- Local speech recognition (FunASR paraformer-zh) ----
# ---- 本地语音识别（FunASR paraformer-zh）----
# Point at an already-downloaded model directory to skip the download.
# Leave empty to use the default ModelScope cache.
# 指定已下载的模型目录可跳过重复下载；留空使用 ModelScope 默认缓存
JKINCO_ASR_MODEL_DIR=
# Proper-noun bias: contract sections, client organizations, recurring participant names.
# Separate with 、 , or spaces. These are the words a general ASR model has never seen.
# 专有名词偏置：标段名、甲方单位、常出现的人名，顿号/逗号/空格分隔
JKINCO_ASR_EXTRA_TERMS=
# Local live captions are part of the default experience. The first use downloads the
# paraformer-zh-streaming model; after that, captions run entirely on this machine.
# Set to 0 only when you want to save memory or disable live captions.
# 本地实时字幕是默认体验的一部分。首次使用会下载 paraformer-zh-streaming 模型，
# 之后识别完全在本机运行。只有想节省内存或明确关闭实时字幕时才设为 0。
JKINCO_REALTIME_LOCAL_ASR=1

# ---- Service / 服务 ----
JKINCO_HOST=0.0.0.0
JKINCO_PORT=8080
JKINCO_JOB_WORKERS=2
JKINCO_MAX_PENDING_JOBS=12
JKINCO_MAX_UPLOAD_BYTES=524288000
JKINCO_MAX_AUDIO_SECONDS=21600
JKINCO_HISTORY_DIR=./history
# Demo mode: when history is empty, seed two example minutes so the UI, export, and
# history search are usable without downloading any model.
# 示例数据模式：置 1 后历史为空时自动写入两条示例纪要，
# 不下载模型也能先体验界面、导出与历史检索
JKINCO_DEMO_DATA=0

# ---- Optional integrations. Unconfigured features disable themselves. ----
# ---- 可选集成：不配置则对应功能自动关闭 ----
# DingTalk bot delivery (signed requests) / 钉钉机器人推送（加签方式）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# ---- Self-hosted real-time meetings (LiveKit) ----
# ---- 自托管实时会议（LiveKit）----
# docker compose starts LiveKit in development mode with the public devkey/secret pair.
# These ports bind to loopback by default, so this is safe only for a local trial.
# Before allowing LAN or internet access:
#   1. generate a real key/secret pair;
#   2. set LIVEKIT_HOST_BIND=0.0.0.0;
#   3. set LIVEKIT_NODE_IP and LIVEKIT_PUBLIC_URL to the reachable host/IP;
#   4. put LiveKit behind TLS and restrict the exposed ports in your firewall.
# docker compose 会用 LiveKit 开发模式启动，默认 devkey/secret 仅适合本机试用。
# 开放局域网或公网前，请更换密钥、设置可达地址，并在前置代理启用 TLS。
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
# The backend reaches LiveKit over the Compose network.
# 后端通过 Compose 内网访问 LiveKit。
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_HOST_BIND=127.0.0.1
